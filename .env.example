# Copier en « .env » puis adapter avant un « docker compose up ».
POSTGRES_DB=musicstore
POSTGRES_USER=musicstore
POSTGRES_PASSWORD=changez-moi
POSTGRES_PORT=5432

API_PORT=8080
WEB_PORT=8081

# Cle de signature des jetons : au moins 32 octets, differente en production.
MUSICSTORE_JWT_SECRET=dev-secret-musicstore-a-remplacer-en-production-32-octets-minimum
# Motifs acceptes : « http://localhost:[*] » autorise n'importe quel port local.
MUSICSTORE_CORS_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]
MUSICSTORE_SEED_ENABLED=true
